# --- App ---
ENV=development                      # development | production (production turns on strict startup checks)
SECRET_KEY=change-me-long-random-string   # 32+ random characters in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=60
CLINIC_TIMEZONE=Asia/Kolkata          # doctors' weekly hours and appointment slots use this IANA zone

# --- Database (external Render Postgres) ---
# sqlite:///./clinicalscribe.db also works for a quick local run.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.oregon-postgres.render.com/DBNAME?sslmode=require

# --- First admin (used once by scripts/create_admin.py) ---
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password   # 12+ characters with letters and digits

# --- AWS S3 ---
STORAGE_BACKEND=local                # local (dev only, .local_storage/) | s3 (required in production)
LOCAL_STORAGE_DIR=                   # optional override for the local backend
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1
S3_BUCKET_NAME=clinicalscribe-private-files
PRESIGNED_URL_EXPIRY_SECONDS=300

# --- LLM (SOAP + prescription agents) ---
LLM_PROVIDER=gemini                  # gemini | mock. mock = canned, transcript-independent demo output (never in production)
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini-3.8-flash           # verify the model id you have access to
LLM_BASE_URL=https://generativelanguage.googleapis.com

# --- ElevenLabs (speech-to-text + voice agent / TTS) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Speech-to-text (consult audio -> transcript)
STT_PROVIDER=elevenlabs              # elevenlabs | mock (mock returns a fixed sample, never in production)
STT_MODEL=scribe_v1                  # scribe_v1 or scribe_v2; verify the latest Scribe model id in ElevenLabs docs
STT_LANGUAGE=en                      # en | hi | auto
MAX_AUDIO_MB=25
DELETE_AUDIO_AFTER_TRANSCRIPTION=false

# Voice agent / text-to-speech
VOICE_AGENT_PROVIDER=elevenlabs      # elevenlabs | none
ELEVENLABS_AGENT_ID=your-agent-id
ELEVENLABS_VOICE_ID=your-voice-id
